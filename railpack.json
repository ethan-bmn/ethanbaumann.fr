{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "commands": ["bun install --frozen-lockfile"]
    },
    "build": {
      "commands": ["bun run build"]
    }
  },
  "deploy": {
    "startCommand": "node .output/server/index.mjs",
    "variables": {
      "NODE_ENV": "production",
      "HOST": "0.0.0.0",
      "PORT": "3000"
    }
  }
}
