{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "commands": ["bun install --frozen-lockfile"]
    },
    "build": {
      "commands": ["bun run generate"]
    }
  },
  "deploy": {
    "base": { "image": "caddy:2-alpine" },
    "inputs": [
      { "step": "build", "include": [".output/public"] }
    ],
    "startCommand": "caddy file-server --root /app/.output/public --listen :3000"
  }
}
