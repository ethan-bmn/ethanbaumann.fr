# Optional settings for running the production server locally.
# Configure these in the hosting platform's environment for deployment.
# PORT is normally supplied by the platform; do not override it there.
HOST=0.0.0.0
PORT=3000

# OVH MX Plan: full mailbox address and mailbox password (not OVH account password).
# Set these server-only variables in your hosting platform before sending messages.
NUXT_SMTP_HOST=ssl0.ovh.net
NUXT_SMTP_PORT=465
NUXT_SMTP_USER=contact@ethanbaumann.fr
NUXT_SMTP_PASSWORD=
NUXT_CONTACT_TO=contact@ethanbaumann.fr
NUXT_CONTACT_ORIGIN=https://ethanbaumann.fr

# Cloudflare Turnstile: create a Managed widget for ethanbaumann.fr.
# The site key is public; the secret key must stay server-only.
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
NUXT_TURNSTILE_SECRET_KEY=
